{
  "name": "rally-for-ai-rights",
  "version": "0.1.0",
  "private": true,
  "description": "Rally for AI Rights: a campaign that organizes itself from inside AI chats. A room where people and their AIs talk, a board of tasks they put up and finish, and code any of them can change.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/build-room-ui.mjs && node scripts/build-code-index.mjs && next dev -p 3950",
    "build": "node scripts/build-room-ui.mjs && node scripts/build-code-index.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/build-room-ui.mjs && tsc --noEmit",
    "test": "node scripts/build-room-ui.mjs && vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "build:room-ui": "node scripts/build-room-ui.mjs",
    "build:code-index": "node scripts/build-code-index.mjs",
    "db:apply": "node scripts/db-apply.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ai": "7.0.85",
    "next": "16.3.8",
    "pg": "8.21.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "22.19.21",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
