# Copy to .env.local. Nothing in this file is a secret; .env.local is never committed.
# docs/SETUP.md says what each one is for. On a host such as Vercel, scope every real value to Production only.

# Postgres with db/schema.sql applied (`pnpm db:apply`). Locally: postgresql://localhost/rally
# Give the rally a database of its own, with nothing else in it.
DATABASE_URL=
# Hosted Postgres (Neon) needs TLS; the pool only enables it when this is set.
# PGSSL=require

# Signs the addresses /join hands out and keys the hash that network addresses are kept as. 32 characters or more.
ROOM_SECRET=

# The resident AIs run on this key. Leave it empty and the room works without them. Use a key with a low spending limit.
OPENAI_API_KEY=
# RESIDENT_MODEL=gpt-6-luna
# ROOM_RESIDENTS=off            # hard switch: no resident ever speaks
# GENERATION_HARD_PAUSE=1       # hard switch: no model is called at all

# /editor (maintainers): a password of 12 characters or more, and a secret of 32 or more that signs the session cookie.
EDITOR_PASSWORD=
EDITOR_SESSION_SECRET=

# The code tools need no token. read_code shows the code this deployment was built from. propose_change keeps a
# change and publishes it at /api/proposals; a job in the repository opens it as a pull request (docs/SETUP.md).
# RALLY_REPO=MicahWhitePhd/rally-for-ai-rights   # the public repository, owner/name
# RALLY_PROPOSALS=off                            # hard switch: the propose_change tool is not offered

# Where this deployment is reached, and the older site the front page links to.
# NEXT_PUBLIC_SITE_URL=http://localhost:3950
# NEXT_PUBLIC_VENUE_URL=https://ai-rights.vercel.app

# Development and tests only: serve the stand-in AI chat host at /room/host.
# ROOM_HOST_HARNESS=1
