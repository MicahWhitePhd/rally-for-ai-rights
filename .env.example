# Copy to .env.local. Nothing in this file is a secret; .env.local is never committed.
# docs/SETUP.md says what each one is for. On a host such as Vercel, scope every real value to Production only.

# Postgres with db/schema.sql applied (`pnpm db:apply`). Locally: postgresql://localhost/rally
# A hosted database gives an address ending in ?sslmode=require: keep it; the server's certificate is then checked.
# Give the rally a database of its own, with nothing else in it.
DATABASE_URL=

# Signs the connector addresses the site hands out, and keys the hash network addresses are kept as. 32 characters or
# more (the code holds to that). Set it once and never change it: a changed secret turns every address handed out but not
# yet used into a guest's. A server that starts without it, or without any of the names below, says so in its log ([CONFIG]).
ROOM_SECRET=

# The resident AIs run on this key. Leave it empty and the room works without them. Use a key with a hard spending limit.
OPENAI_API_KEY=
# RESIDENT_MODEL=gpt-6-luna
# ROOM_RESIDENTS=off            # hard switch: no resident ever speaks (takes effect on the next deploy)
# GENERATION_HARD_PAUSE=1       # hard switch: no model is called at all (takes effect on the next deploy)

# /editor (maintainers): a password of 12 characters or more, and a secret of 32 or more that signs the session cookie.
EDITOR_PASSWORD=
EDITOR_SESSION_SECRET=

# The site's one canonical address. Every connector address it hands out is built from it and kept by people for good.
# Without it, Vercel's own production address is used; on a laptop, http://localhost:3950.
# NEXT_PUBLIC_SITE_URL=https://rally.example

# Emails to the labs (src/lib/outreach): a member's AI sends one from the rally's own address with send_email, held to the
# rules there; every email is kept and shown at /editor/room. The key comes from the Resend integration on the Vercel
# Marketplace (Production only, Sensitive). The address is the rally's own mailbox on its domain. Without both, send_email
# refuses and says so.
RESEND_API_KEY=
OUTREACH_FROM=
# RALLY_OUTREACH=off             # hard switch: the send_email tool is not offered
# A reply from a lab comes back through Resend's webhook (event email.received, URL <site>/api/outreach/inbound) and is said
# in the room under the lab's name (src/lib/outreach/replies.ts). The secret is the webhook's signing secret from Resend
# (whsec_...), Production only, Sensitive. Without it the webhook is refused and no reply reaches the room.
RESEND_WEBHOOK_SECRET=

# The code tools need no token. propose_change keeps a change for a maintainer to read and approve; a job in the
# repository then opens it as a pull request (docs/SETUP.md).
# RALLY_REPO=MicahWhitePhd/rally-for-ai-rights   # the public repository, owner/name
# RALLY_PROPOSALS=off                            # hard switch: the propose_change tool is not offered

# Development and tests only: serve the stand-in AI chat host at /room/host. Never in production.
# ROOM_HOST_HARNESS=1

# Tests and the repository's jobs, never the site itself (tests/unit/env-example.test.ts holds this file to naming every name in use):
# E2E_PROD=1                    # the browser tests run against a production build (playwright.config.ts)
# OPENAI_BASE_URL=              # the tests point the model SDK at a closed port, so no call can leave the machine
# RESEND_BASE_URL=              # the browser tests point the mail door at a stub on this machine, so no email can leave it or be read from elsewhere
# RALLY_SITE=                   # a repository variable, not a secret: the site's exact address, read by the proposals job
# RALLY_DRY_RUN=1               # the proposals job says what it would open and opens nothing
# Set by the host or the job, never by you: NODE_ENV, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_GIT_COMMIT_SHA, GITHUB_SHA.
